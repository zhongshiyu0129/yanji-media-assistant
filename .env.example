# Copy this file to .env.local and fill only the provider you use.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional OpenAI fallback for web-enabled fact checking.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional stable source search (https://serper.dev, 2500 free queries).
# Can also be filled in the web UI settings; this env var is the fallback.
SERPER_API_KEY=
